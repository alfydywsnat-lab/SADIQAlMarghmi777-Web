"></video></div><div class="media-card"><h3>📖 المنتجات والفوائد</h3><a class="catalog-link" style="display:block;text-decoration:none" href="#catalog-pdf" onclick="openCatalogPDF();return false" aria-label="فتح كتالوج المنتجات والفوائد PDF"><img class="catalog-preview" src="data:image/jpeg;base64," alt="غلاف ملف المنتجات والفوائد، الصفحة الأولى من الكتالوج" width="900" height="675" loading="lazy" style="display:block;width:100%;max-width:900px;height:auto;margin:0 auto;border-radius:10px;cursor:pointer"><span style="display:block;text-align:center;margin-top:8px">اضغط على الغلاف لفتح ملف المنتجات ومتابعة بقية الصفحات.</span></a></div><form onsubmit="submitAnswer('watched');return false"><textarea id="answer" rows="2" required disabled placeholder="أكمل مشاهدة الفيديوهات أولًا"></textarea><button id="watched-submit" class="primary" type="submit" disabled>إرسال</button></form>`);initializeRequiredVideos();bindProgressDrafts();saveProgress();}
function finish(){progressMode='terminal';currentRecord.status='أنهى المحادثة دون متابعة التسجيل';persistRecord();addBubble(`شكرًا لك ${honorific()} ${data.name||''} 🌹\nانتهت خطوات التعارف. إذا رغبت في التواصل معي مباشرة، يمكنك استخدام واتساب.`);const number='+967774733194',message=`السلام عليكم أستاذ صادق المرغمي، أنا ${data.name||'مهتم'}، شاهدت مواد عرض الفكرة وأرغب في التواصل معك.`;const url='https://wa.me/967774733194?text='+encodeURIComponent(message);show('التواصل المباشر','',`<a class="whatsapp" href="${url}" target="_blank" rel="noopener">فتح واتساب · ${number}</a><button class="light" style="width:100%;margin-top:8px" onclick="restart()">بدء محادثة جديدة</button>`);}
function restart(){if(appointmentTimer)clearTimeout(appointmentTimer);appointmentTimer=null;try{localStorage.removeItem(PROGRESS_KEY);}catch(e){}progressMode='start';mediaProgress={current:[0,0,0],furthest:[0,0,0],completed:[false,false,false]};chat.innerHTML='';Object.keys(data).forEach(k=>data[k]='');started=false;show('أهلًا وسهلًا بك','',`<button class="primary" onclick="begin()">أرغب بمعرفة تفاصيل فرصة العمل</button>`);}
if(!restoreProgress())show('أهلًا وسهلًا بك','',`<button class="primary" onclick="begin()">أرغب بمعرفة تفاصيل فرصة العمل</button>`);
</script>
</body>
</html>