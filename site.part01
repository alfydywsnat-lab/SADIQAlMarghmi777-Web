 else if(key==='global'){addBubble('يا سلام، شكرًا على إجابتك.');ask('السؤال السابع','هل أنت من الأشخاص الذين يتأثرون بكلام الناس ويتوقفون، أم أنك تصرّ على هدفك ولا تستسلم من أول محاولة؟','persistence','اكتب إجابتك هنا');}
 else if(key==='persistence'){ask('السؤال الثامن','لو تم قبولك معنا، ماذا تفضّل: راتبًا ثابتًا أم نسبةً حسب الجهد والنتائج؟','incomeType','اكتب إجابتك هنا');}
 else if(key==='incomeType'){
