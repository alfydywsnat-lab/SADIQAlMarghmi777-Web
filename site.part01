  else if(['employee','worker'].includes(selectedProfile)){addBubble(selectedProfile==='worker'?'الله يبارك لك في عملك.':'الله يبارك لك في وظيفتك.');ask('','ومنذ متى وأنت تعمل في هذا المجال؟','duration','اكتب إجابتك بحرية');}
  else{ask('','ما أكثر شيء تتمنى أن يتحسن في وضعك الحالي؟','wish','اكتب إجابتك هنا');}
 }else if(key==='duration'){addBubble(`ما شاء الله، ${val} تدل على أنك شخص ملتزم وتحب الاستقرار في عملك، وهذه صفة جميلة.`);ask('','ما أكثر شيء تتمنى أن يتحسن في عملك الحالي؟','wish','اكتب إجابتك هنا');}
 else if(key==='wish'){addBubble('أفهمك تمامًا.');ask('التفكير بالمستقبل','ولو بقي وضعك كما هو اليوم خلال السنوات الخمس القادمة، هل ستكون راضيًا عن النتيجة؟','future','اكتب إجابتك هنا');}
 else if(key==='future'){addBubble(`${honorific()} ${data.name}...\n\nمن خلال حديثنا، فهمت أنك تبحث عن ${goalContext()}.\nهل هذا صحيح؟`);ask('تأكيد الفهم','','summary','اكتب إجابتك هنا');}
 else if(key==='summary'){if(/لا|غير صحيح|ليس تمام|تصحيح/i.test(val)){ask('توضيح الفهم','ما الذي تريد تصحيحه في فهمي لاحتياجك؟','correction','اكتب التصحيح هنا');}else askProjectQuestion();}
 else if(key==='correction'){addBubble('شكرًا لك على التوضيح.');addBubble(`من خلال حديثنا، فهمت أنك تبحث عن فرصة تناسب ما أوضحته لي، وتساعدك على تحقيق أهدافك. هل فهمت احتياجك بشكل صحيح؟`);ask('تأكيد الفهم','','summary2','اكتب إجابتك هنا');}
 else if(key==='summary2'){if(/لا|غير صحيح/i.test(val))ask('توضيح الفهم','ما الذي أحتاج إلى تصحيحه؟','correction','اكتب التصحيح هنا');else askProjectQuestion();}
 else if(key==='interest'){if(/لا|غير مناسب|لا أبحث/i.test(val)){addBubble('أقدّر صراحتك، والقرار لك.');finish();}else{addBubble('ولو كان المشروع لا يشترط خبرة سابقة، ويوجد تدريب ومتابعة خطوة بخطوة حتى تتقنه. وقروبات خاصة بالنساء وقروبات خاصة بالرجال..\nهل سيعطيك ذلك ثقة أكبر للبدء؟');ask('التدريب والمتابعة','','confidence','اكتب إجابتك هنا');}}
 else if(key==='confidence'){addBubble('ممتاز، حلو، شيء جميل.');addBubble('حتى يكون قرارك مبنيًا على معرفة كاملة، أفضّل أن تتعرف على الفكرة بنفسك...\nسأرسل لك شرحًا مختصرًا يتكون من:\n🎧 فيديو قصير جدًا عن صناعة البيع المباشر والمشروع.\n🎥 وقصة نجاح.\n📖 وكتالوج المنتجات.\nبعد مشاهدتها، سأجيب عن جميع استفساراتك بكل شفافية، ثم تقرر بنفسك إن كانت هذه الفرصة تناسبك أم لا.\nهل يناسبك أن أرسلها لك؟');ask('إرسال المواد التعريفية','','send','اكتب إجابتك هنا');}else if(key==='continue'){if(/نعم|أتابع|موافق|تمام|اكمل|أكيد/i.test(val)){addBubble('ممتاز جدًا. أنا أحيّي طموحك.');ask('إرسال المواد التعريفية','حتى يكون قرارك مبنيًا على معرفة كاملة، أفضّل أن تتعرف على الفكرة بنفسك. سأرسل لك فيديو البيع المباشر، وقصة نجاح، وكتالوج المنتجات. هل يناسبك أن أرسلها لك؟','send','اكتب إجابتك هنا');}else finish();}
 else if(key==='send'){if(/لا|ليس الآن|لاحقًا|بعدين/i.test(val)){ask('تحديد موعد','متى يناسبك أن نتابع؟ اكتب الوقت الذي يناسبك.','customTime','اكتب الوقت الذي يناسبك');}else showAppointment();}
 else if(key==='customTime'){data.time=val;showAppointment();}
 else if(key==='appointment'){handleAppointmentChoice(val);}
 else if(key==='watched'){
