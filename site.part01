 else if(key==='longTerm'){ask('السؤال الثاني عشر','هل أنت مستعد للتدرب والتعلم وتنفيذ المهام اليومية واتباع إرشادات التدريب؟','training','اكتب إجابتك هنا');}
 else if(key==='training'){addBubble('أريد منك أن تكون صادقًا مع أحلامك، وأن تلتزم بالتعلم. ومن المهم أيضًا ألا تتحدث عن تجربة المنتجات من منظور شخصي قبل أن تجربها بنفسك.');ask('السؤال الثالث عشر','هل توافق على تجربة المنتجات حسب قدرتك واستطاعتك، دون ضغط أو إلزام؟','productsPromise','اكتب إجابتك هنا');}
