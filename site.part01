  ask('تحديد الطموح المالي','','incomeGoal','اكتب مبلغك بالأرقام');
 }
 else if(key==='incomeGoal'){if(!/\d/.test(val)){ask('تحديد الطموح المالي','من فضلك اكتب مبلغًا محددًا بالأرقام، مثل 100 أو 300 أو 500 أو 1000 أو 50000 أو 100000 دولار.','incomeGoal','اكتب مبلغًا بالأرقام');return;}ask('السؤال العاشر','لتحقيق هدفك المالي، هل تستطيع تخصيص ساعتين إلى ثلاث ساعات يوميًا على الأقل للتعلم والعمل؟ تذكّر أن الدخل غير مضمون ويختلف حسب الجهد والنتائج.','dailyTime','اكتب إجابتك هنا');}
