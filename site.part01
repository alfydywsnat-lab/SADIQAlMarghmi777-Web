  }else{ask('متابعة العرض','تابع، وعندما تكون جاهزًا أخبرني أنك جاهز لنناقشك، لأنني سوف أقدم لك بعض الأسئلة.','watched','اكتب ردك هنا');}
 }
 else if(key==='ready'){addBubble('أهلًا وسهلًا بك.');ask('السؤال الأول','من خلال مشاهدتك الفيديوهات السابقة، ما الشيء الذي لفت انتباهك أو أعجبك؟ اكتب رأيك كما تحب.','liked','اكتب رأيك هنا كما تحب');}
