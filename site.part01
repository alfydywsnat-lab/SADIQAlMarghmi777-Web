 else if(key==='countries'){addBubble('إجابتك تدل على تركيزك وهمّتك والتزامك، وهذا شيء مميز.');ask('السؤال الخامس','من خلال اطلاعك على كتالوج المنتجات، ما انطباعك عنها أو كم منتجًا تتذكر؟ أجب بالطريقة التي تناسبك، ولا يشترط ذكر أسماء المنتجات.','products','اكتب إجابتك هنا');}
