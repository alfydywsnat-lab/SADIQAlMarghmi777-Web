';
function openCatalogPDF(){const raw=atob(CATALOG_PDF_BASE64),bytes=new Uint8Array(raw.length);for(let i=0;i<raw.length;i++)bytes[i]=raw.charCodeAt(i);const url=URL.createObjectURL(new Blob([bytes],{type:'application/pdf'}));const tab=window.open(url,'_blank');if(!tab){const a=document.createElement('a');a.href=url;a.download='كتالوجمنتجاتDXN.pdf';a.click();}setTimeout(()=>URL.revokeObjectURL(url),120000);}
const data={name:'',birthYear:'',country:'',educationWork:'',workDetails:'',duration:'',wish:'',future:'',summary:'',interest:'',confidence:'',permission:'',send:'',appointment:'',time:'',correction:'',clarification:'',source:'',watched:''};
